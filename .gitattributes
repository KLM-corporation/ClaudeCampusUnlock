# Auto detect text files and perform LF normalization
* text=auto

# Ensure shell scripts always use LF line endings (required for Termux/Linux execution)
*.sh text eol=lf
*.bash text eol=lf

# Windows PowerShell and batch scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Documentation and configs
*.md text
*.yml text
*.yaml text
*.json text
*.txt text
.gitignore text
.gitattributes text
LICENSE text
